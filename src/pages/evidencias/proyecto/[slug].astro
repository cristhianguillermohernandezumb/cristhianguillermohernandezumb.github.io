---
import Layout from '@/layouts/Layout.astro'
import { projectSections } from '@/data/proyecto'

export function getStaticPaths() {
	return projectSections
		.filter(section => section.kind !== 'direct-link')
		.map(section => ({
			params: { slug: section.slug },
			props: { section },
		}))
}

const { section } = Astro.props
const imageUrl =
	section.kind === 'image' && section.imagePath
		? `${import.meta.env.BASE_URL}${section.imagePath}`
		: ''
---

<Layout title={section.title}>
	<section class='py-12'>
		<div class='max-w-screen-lg mx-auto'>
			<a
				href={`${import.meta.env.BASE_URL}evidencias/proyecto/`}
				class='btn btn-ghost btn-sm mb-6'
			>
				Volver a Proyecto
			</a>
			<article class='card bg-base-200'>
				<div class='card-body'>
					<div class='flex flex-wrap justify-between items-start gap-4'>
						<h1 class='card-title text-3xl'>{section.title}</h1>
						<div class='badge badge-accent badge-outline p-4'>
							{section.badge}
						</div>
					</div>
					<p class='text-sm text-base-content/71'>{section.date}</p>
					<p class='mt-4'>{section.description}</p>
					{
						section.kind === 'image' ? (
							imageUrl ? (
								<a
									href={imageUrl}
									target='_blank'
									rel='noopener noreferrer'
									class='mt-4 block'
									aria-label={`Abrir imagen completa: ${section.imageAlt}`}
								>
									<img
										src={imageUrl}
										alt={section.imageAlt}
										class='mx-auto max-h-[75vh] max-w-full rounded-lg object-contain'
									/>
									<p class='mt-2 text-center text-sm text-base-content/70'>
										Pulsa la imagen para abrirla en una pestaña completa.
									</p>
								</a>
							) : (
								<p class='mt-4 text-base-content/70'>
									Agrega la ruta de la imagen en src/data/proyecto.ts para mostrarla aquí.
								</p>
							)
						) : (
							<div class='mt-6'>
								<h2 class='text-xl font-semibold'>Enlace</h2>
								<a
									href={section.link}
									target='_blank'
									rel='noopener noreferrer'
									class='link link-accent mt-2 break-all'
								>
									{section.link === '#' ? 'Agrega aquí la URL del proyecto' : section.link}
								</a>
							</div>
						)
					}
				</div>
			</article>
		</div>
	</section>
</Layout>
