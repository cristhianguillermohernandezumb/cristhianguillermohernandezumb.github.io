---
import Layout from '../../layouts/Layout.astro'
import { modeladoSections } from '@/data/modelado'
---

<Layout>
	<section class='py-12'>
		<div class='max-w-screen-lg mx-auto'>
			<h1 class='text-3xl font-bold mb-8'>Modelado</h1>
			<div class='grid gap-8'>
				{
					modeladoSections.map(section => (
						<article class='card bg-base-200 transition-all'>
							<div class='card-body'>
								<div class='flex justify-between items-start gap-4'>
									<h2 class='card-title text-xl'>{section.title}</h2>
									<div class='badge badge-accent badge-outline p-4'>
										{section.badge}
									</div>
								</div>
								<p class='text-sm text-base-content/71'>{section.date}</p>
								<p class='mt-4'>{section.description}</p>
								<div class='card-actions justify-end'>
									<a
										href={`${import.meta.env.BASE_URL}evidencias/modelado/${section.slug}/`}
										class='btn btn-sm btn-secondary text-secondary-content'
									>
										Read More
									</a>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>
</Layout>
