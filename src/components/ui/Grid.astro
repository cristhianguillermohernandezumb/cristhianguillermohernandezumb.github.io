---
interface Props {
  gridTitle: string;
  gridItems: {
    title: string;
    description: string;
  }[];
}

const {gridTitle, gridItems} = Astro.props;
---
<h2 class="text-3xl font-bold mb-8">{gridTitle}</h2>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
  {gridItems.map((item) => (
    <div class="p-8 rounded-xl text-base-content bg-base-200 w-full h-full">
      <h3 class="text-xl font-semibold mb-4">{item.title}</h3>
      <p>{item.description}</p>
    </div>
  ))}
</div>
